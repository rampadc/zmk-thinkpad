/*
 * ThinkPad T430 keyboard and TrackPoint on the Nordic nRF52840 DK.
 *
 * SPDX-License-Identifier: MIT
 */

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/pinctrl/nrf-pinctrl.h>
#include <dt-bindings/pwm/pwm.h>
#include <dt-bindings/zmk/matrix_transform.h>

/ {
    chosen {
        zmk,kscan = &kscan_composite;
        zmk,matrix-transform = &default_transform;
        zmk,backlight = &keyboard_backlight;
    };

    /*
     * The T430 matrix has sixteen DRV outputs and eight active-low SENSE
     * inputs. DRVn/SENSEn names and connector pins are documented in the
     * README wiring table.
     */
    kscan_matrix: kscan_matrix {
        compatible = "zmk,kscan-gpio-matrix";
        wakeup-source;
        diode-direction = "row2col";

        /* DRV0 through DRV15, in order. */
        row-gpios =
            <&gpio0 3 GPIO_ACTIVE_LOW>,
            <&gpio0 4 GPIO_ACTIVE_LOW>,
            <&gpio0 17 GPIO_ACTIVE_LOW>,
            <&gpio0 19 GPIO_ACTIVE_LOW>,
            <&gpio0 20 GPIO_ACTIVE_LOW>,
            <&gpio0 21 GPIO_ACTIVE_LOW>,
            <&gpio0 22 GPIO_ACTIVE_LOW>,
            <&gpio0 23 GPIO_ACTIVE_LOW>,
            <&gpio0 28 GPIO_ACTIVE_LOW>,
            <&gpio0 29 GPIO_ACTIVE_LOW>,
            <&gpio0 30 GPIO_ACTIVE_LOW>,
            <&gpio0 31 GPIO_ACTIVE_LOW>,
            <&gpio1 0 GPIO_ACTIVE_LOW>,
            <&gpio1 1 GPIO_ACTIVE_LOW>,
            <&gpio1 2 GPIO_ACTIVE_LOW>,
            <&gpio1 3 GPIO_ACTIVE_LOW>;

        /* SENSE0 through SENSE7, in order. */
        col-gpios =
            <&gpio1 4 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,
            <&gpio1 5 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,
            <&gpio1 6 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,
            <&gpio1 7 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,
            <&gpio1 9 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,
            <&gpio1 10 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,
            <&gpio1 11 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,
            <&gpio1 13 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
    };

    /*
     * Fn (-HOTKEY) and the power switch are outside the matrix. The four DK
     * switches remain available as recovery/bring-up controls.
     */
    kscan_direct: kscan_direct {
        compatible = "zmk,kscan-gpio-direct";
        wakeup-source;
        input-gpios =
            <&gpio1 14 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,
            <&gpio1 15 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,
            <&gpio0 11 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,
            <&gpio0 12 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,
            <&gpio0 24 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,
            <&gpio0 25 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
    };

    kscan_composite: kscan_composite {
        compatible = "zmk,kscan-composite";
        wakeup-source;
        rows = <17>;
        columns = <8>;

        matrix {
            kscan = <&kscan_matrix>;
        };

        direct {
            kscan = <&kscan_direct>;
            row-offset = <16>;
        };
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <8>;
        rows = <17>;

        /* Ordered by the physical US keyboard layout, not matrix order. */
        map = <
            /* Power; dedicated audio/ThinkVantage buttons. */
            RC(16,1)
            RC(10,4) RC(10,3) RC(10,2) RC(10,6) RC(10,5)

            /* Function and navigation row. */
            RC(0,5)
            RC(1,0) RC(2,0) RC(2,3) RC(2,5)
            RC(8,5) RC(5,5) RC(6,3) RC(6,0)
            RC(8,0) RC(8,1) RC(10,1) RC(9,1)
            RC(11,1) RC(11,0) RC(10,0) RC(12,1)
            RC(11,6) RC(11,7)

            /* Number row. */
            RC(0,0) RC(0,1) RC(1,1) RC(2,1) RC(3,1)
            RC(3,0) RC(4,0) RC(4,1) RC(5,1) RC(6,1)
            RC(7,1) RC(7,0) RC(5,0) RC(8,3)

            /* QWERTY row. */
            RC(0,3) RC(0,2) RC(1,2) RC(2,2) RC(3,2)
            RC(3,3) RC(4,3) RC(4,2) RC(5,2) RC(6,2)
            RC(7,2) RC(7,3) RC(5,3) RC(8,4)

            /* Home row. */
            RC(1,3) RC(0,4) RC(1,4) RC(2,4) RC(3,4)
            RC(3,5) RC(4,5) RC(4,4) RC(5,4) RC(6,4)
            RC(7,4) RC(7,5) RC(8,6)

            /* Shift row. */
            RC(14,3) RC(0,6) RC(1,6) RC(2,6) RC(3,6)
            RC(3,7) RC(4,7) RC(4,6) RC(5,6) RC(6,6)
            RC(7,7) RC(14,6)

            /* Bottom row and cursor cluster. */
            RC(16,0) RC(15,0) RC(9,3) RC(13,5)
            RC(8,7) RC(13,7) RC(11,4) RC(15,6)
            RC(12,7) RC(12,5) RC(10,7) RC(9,7)

            /* DK SW1 through SW4 recovery controls. */
            RC(16,2) RC(16,3) RC(16,4) RC(16,5)
        >;
    };

    keyboard_backlight: keyboard_backlight {
        compatible = "pwm-leds";

        pwm_led_0 {
            /* The original EC drives KBD_BL_PWM as active-high 3.3 V logic. */
            pwms = <&pwm1 0 PWM_USEC(1000) PWM_POLARITY_NORMAL>;
        };
    };

    t430_indicators: t430_indicators {
        compatible = "gpio-leds";

        t430_power_led: power_led {
            /* Also mirrors onto DK LED1 during bring-up. */
            gpios = <&gpio0 13 GPIO_ACTIVE_LOW>;
        };

        t430_mute_led: mute_led {
            /* Also mirrors onto DK LED2 during bring-up. */
            gpios = <&gpio0 14 GPIO_ACTIVE_LOW>;
        };

        t430_micmute_led: micmute_led {
            /* Also mirrors onto DK LED3 during bring-up. */
            gpios = <&gpio0 15 GPIO_ACTIVE_LOW>;
        };

        t430_profile_1_led: profile_1_led {
            /* Mirrors onto DK LED4 during bring-up. */
            gpios = <&gpio0 16 GPIO_ACTIVE_LOW>;
        };

        t430_profile_2_led: profile_2_led {
            /* External active-low LED for DK bring-up. */
            gpios = <&gpio0 2 GPIO_ACTIVE_LOW>;
        };

        t430_profile_3_led: profile_3_led {
            /* External active-low LED; UART0 RTS is deliberately released below. */
            gpios = <&gpio0 5 GPIO_ACTIVE_LOW>;
        };
    };

    trackpoint: trackpoint {
        compatible = "zmk,input-mouse-ps2";
        status = "okay";
        ps2-device = <&trackpoint_ps2>;
        rst-gpios = <&gpio1 8 GPIO_ACTIVE_HIGH>;

        sampling-rate = <100>;
        tp-sensitivity = <128>;
        tp-neg-inertia = <6>;
        tp-y-invert;
    };

    trackpoint_listener: trackpoint_listener {
        compatible = "zmk,input-listener";
        status = "okay";
        device = <&trackpoint>;
    };
};

/*
 * UARTE1 receives PS/2 DATA at the closest supported rate to the TrackPoint
 * clock. Transmit commands are sent by the module using GPIO timing.
 */
&pinctrl {
    uart0_console_default: uart0_console_default {
        group1 {
            psels = <NRF_PSEL(UART_TX, 0, 6)>;
        };

        group2 {
            psels = <NRF_PSEL(UART_RX, 0, 8)>;
            bias-pull-up;
        };
    };

    uart0_console_sleep: uart0_console_sleep {
        group1 {
            psels = <NRF_PSEL(UART_TX, 0, 6)>,
                    <NRF_PSEL(UART_RX, 0, 8)>;
            low-power-enable;
        };
    };

    pwm1_keyboard_default: pwm1_keyboard_default {
        group1 {
            psels = <NRF_PSEL(PWM_OUT0, 1, 12)>;
        };
    };

    pwm1_keyboard_sleep: pwm1_keyboard_sleep {
        group1 {
            psels = <NRF_PSEL(PWM_OUT0, 1, 12)>;
            low-power-enable;
        };
    };

    uart1_trackpoint_default: uart1_trackpoint_default {
        group1 {
            psels = <NRF_PSEL_DISCONNECTED(UART_TX)>,
                    <NRF_PSEL(UART_RX, 0, 26)>;
            bias-pull-up;
        };
    };

    uart1_trackpoint_sleep: uart1_trackpoint_sleep {
        group1 {
            psels = <NRF_PSEL_DISCONNECTED(UART_TX)>,
                    <NRF_PSEL_DISCONNECTED(UART_RX)>;
        };
    };
};

/* P0.26 and P0.27 are the DK's default Arduino I2C pins. */
&arduino_i2c {
    status = "disabled";
};

/* P1.08 is SPI1 MISO in the board defaults and is used here for TP reset. */
&spi1 {
    status = "disabled";
};

/* Matrix DRV2/DRV4-DRV8 reuse the pins connected to the DK QSPI flash. */
&qspi {
    status = "disabled";
};

/* Fn and power use P1.14/P1.15, normally Arduino SPI MISO/SCK. */
&arduino_spi {
    status = "disabled";
};

&pwm1 {
    status = "okay";
    pinctrl-0 = <&pwm1_keyboard_default>;
    pinctrl-1 = <&pwm1_keyboard_sleep>;
    pinctrl-names = "default", "sleep";
};

/* Keep UART logging on TX/RX while releasing RTS P0.05 for profile LED 3. */
&uart0 {
    pinctrl-0 = <&uart0_console_default>;
    pinctrl-1 = <&uart0_console_sleep>;
    pinctrl-names = "default", "sleep";
};

/* The shield owns DK LED1-LED4 pins as T430 indicator outputs. */
&led0 { status = "disabled"; };
&led1 { status = "disabled"; };
&led2 { status = "disabled"; };
&led3 { status = "disabled"; };

&uart1 {
    compatible = "nordic,nrf-uarte";
    status = "okay";
    current-speed = <14400>;
    pinctrl-0 = <&uart1_trackpoint_default>;
    pinctrl-1 = <&uart1_trackpoint_sleep>;
    pinctrl-names = "default", "sleep";

    trackpoint_ps2: ps2 {
        compatible = "uart-ps2";
        status = "okay";
        /* nRF-side pull-ups are internal; only the translator's 5 V side
         * needs external pull-ups for the open-collector PS/2 bus. */
        scl-gpios = <&gpio0 27 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        sda-gpios = <&gpio0 26 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
    };
};

/* PS/2 clock edges must pre-empt the Bluetooth controller. */
&gpiote {
    interrupts = <6 0>;
};

/*
 * Generated with the TrackPoint module's gen_interrupt_priority_overrides.py
 * from this shield's compiled nRF52840 DK devicetree. Bluetooth controller
 * priorities are shifted to 1/2 by the module's Kconfig; all other SoC IRQs
 * are kept below GPIOTE at priority 3.
 */
&clock { interrupts = <0 3>; };
&power { interrupts = <0 3>; };
&radio { interrupts = <1 3>; };
&uart0 { interrupts = <2 3>; };
&i2c0 { interrupts = <3 3>; };
&spi0 { interrupts = <3 3>; };
&i2c1 { interrupts = <4 3>; };
&spi1 { interrupts = <4 3>; };
&nfct { interrupts = <5 3>; };
&adc { interrupts = <7 3>; };
&timer0 { interrupts = <8 3>; };
&timer1 { interrupts = <9 3>; };
&timer2 { interrupts = <10 3>; };
&rtc0 { interrupts = <11 3>; };
&temp { interrupts = <12 3>; };
&rng { interrupts = <13 3>; };
&ecb { interrupts = <14 3>; };
&ccm { interrupts = <15 3>; };
&wdt { interrupts = <16 3>; };
&rtc1 { interrupts = <17 3>; };
&qdec { interrupts = <18 3>; };
&comp { interrupts = <19 3>; };
&egu0 { interrupts = <20 3>; };
&egu1 { interrupts = <21 3>; };
&egu2 { interrupts = <22 3>; };
&egu3 { interrupts = <23 3>; };
&egu4 { interrupts = <24 3>; };
&egu5 { interrupts = <25 3>; };
&timer3 { interrupts = <26 3>; };
&timer4 { interrupts = <27 3>; };
&pwm0 { interrupts = <28 3>; };
&pdm0 { interrupts = <29 3>; };
&pwm1 { interrupts = <33 3>; };
&pwm2 { interrupts = <34 3>; };
&spi2 { interrupts = <35 3>; };
&rtc2 { interrupts = <36 3>; };
&i2s0 { interrupts = <37 3>; };
&usbd { interrupts = <39 3>; };
&uart1 { interrupts = <40 3>; };
&qspi { interrupts = <41 3>; };
&pwm3 { interrupts = <45 3>; };
&spi3 { interrupts = <47 3>; };
&cryptocell { interrupts = <42 3>; };
