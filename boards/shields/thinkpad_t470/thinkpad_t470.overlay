/*
 * ThinkPad T470 keyboard matrix on the Nordic nRF52840 DK.
 *
 * The transform maps the measured 16 x 8 matrix into physical US-layout order.
 * TrackPoint, keyboard LEDs, and backlight are intentionally out of scope.
 *
 * SPDX-License-Identifier: MIT
 */

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/zmk/matrix_transform.h>
#include <dt-bindings/pinctrl/nrf-pinctrl.h>

/ {
    chosen {
        zmk,kscan = &kscan_composite;
        zmk,matrix-transform = &t470_transform;
    };

    kscan_matrix: kscan_matrix {
        compatible = "zmk,kscan-gpio-matrix";
        wakeup-source;
        diode-direction = "row2col";

        /* DRV0 through DRV15, in order. */
        row-gpios =
            <&gpio1 3 (GPIO_ACTIVE_LOW | GPIO_OPEN_DRAIN)>,
            <&gpio0 26 (GPIO_ACTIVE_LOW | GPIO_OPEN_DRAIN)>,
            <&gpio1 9 (GPIO_ACTIVE_LOW | GPIO_OPEN_DRAIN)>,
            <&gpio0 31 (GPIO_ACTIVE_LOW | GPIO_OPEN_DRAIN)>,
            <&gpio1 10 (GPIO_ACTIVE_LOW | GPIO_OPEN_DRAIN)>,
            <&gpio1 15 (GPIO_ACTIVE_LOW | GPIO_OPEN_DRAIN)>,
            <&gpio0 29 (GPIO_ACTIVE_LOW | GPIO_OPEN_DRAIN)>,
            <&gpio0 5 (GPIO_ACTIVE_LOW | GPIO_OPEN_DRAIN)>,
            <&gpio0 2 (GPIO_ACTIVE_LOW | GPIO_OPEN_DRAIN)>,
            <&gpio1 0 (GPIO_ACTIVE_LOW | GPIO_OPEN_DRAIN)>,
            <&gpio1 8 (GPIO_ACTIVE_LOW | GPIO_OPEN_DRAIN)>,
            <&gpio1 2 (GPIO_ACTIVE_LOW | GPIO_OPEN_DRAIN)>,
            <&gpio1 7 (GPIO_ACTIVE_LOW | GPIO_OPEN_DRAIN)>,
            <&gpio0 24 (GPIO_ACTIVE_LOW | GPIO_OPEN_DRAIN)>,
            <&gpio1 6 (GPIO_ACTIVE_LOW | GPIO_OPEN_DRAIN)>,
            <&gpio1 5 (GPIO_ACTIVE_LOW | GPIO_OPEN_DRAIN)>;

        /* SENSE0 through SENSE7, in order. */
        col-gpios =
            <&gpio0 3 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,
            <&gpio0 7 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,
            <&gpio0 30 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,
            <&gpio0 28 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,
            <&gpio0 4 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,
            <&gpio1 13 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,
            <&gpio0 12 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,
            <&gpio0 27 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
    };

    /* T470 -HOTKEY (Fn) is a separate active-low contact, not matrixed. */
    kscan_fn: kscan_fn {
        compatible = "zmk,kscan-gpio-direct";
        wakeup-source;
        input-gpios = <&gpio1 11 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
    };

    kscan_composite: kscan_composite {
        compatible = "zmk,kscan-composite";
        wakeup-source;
        rows = <17>;
        columns = <8>;

        matrix {
            kscan = <&kscan_matrix>;
        };

        fn {
            kscan = <&kscan_fn>;
            row-offset = <16>;
        };
    };

    t470_transform: t470_transform {
        compatible = "zmk,matrix-transform";
        columns = <8>;
        rows = <17>;
        map = <
            /* Esc, F1-F12, Home, End, Insert, Delete. */
            RC(0,5)  RC(1,0)  RC(2,0)  RC(2,3)  RC(2,5)
            RC(8,5)  RC(5,5)  RC(6,3)  RC(6,0)  RC(8,0)
            RC(8,1)  RC(10,1) RC(9,1)  RC(12,0) RC(12,1)
            RC(9,0)  RC(10,0)

            /* Number row. */
            RC(0,0)  RC(0,1)  RC(1,1)  RC(2,1)  RC(3,1)
            RC(3,0)  RC(4,0)  RC(4,1)  RC(5,1)  RC(6,1)
            RC(7,1)  RC(7,0)  RC(5,0)  RC(8,3)

            /* QWERTY row. */
            RC(0,3)  RC(0,2)  RC(1,2)  RC(2,2)  RC(3,2)
            RC(3,3)  RC(4,3)  RC(4,2)  RC(5,2)  RC(6,2)
            RC(7,2)  RC(7,3)  RC(5,3)  RC(8,4)

            /* Home row. */
            RC(1,3)  RC(0,4)  RC(1,4)  RC(2,4)  RC(3,4)
            RC(3,5)  RC(4,5)  RC(4,4)  RC(5,4)  RC(6,4)
            RC(7,4)  RC(7,5)  RC(8,6)

            /* Shift row. */
            RC(14,3) RC(0,6)  RC(1,6)  RC(2,6)  RC(3,6)
            RC(3,7)  RC(4,7)  RC(4,6)  RC(5,6)  RC(6,6)
            RC(7,7)  RC(14,6)

            /* Bottom row and navigation cluster. */
            RC(16,0) RC(15,0) RC(9,3)  RC(13,5) RC(8,7)
            RC(13,7) RC(13,1) RC(15,6) RC(11,0) RC(12,5)
            RC(11,1) RC(12,7) RC(10,7) RC(9,7)
        >;
    };
};

&pinctrl {
    uart0_t470_default: uart0_t470_default {
        group1 {
            psels = <NRF_PSEL(UART_TX, 0, 6)>;
        };

        group2 {
            psels = <NRF_PSEL(UART_RX, 0, 8)>;
            bias-pull-up;
        };
    };

    uart0_t470_sleep: uart0_t470_sleep {
        group1 {
            psels = <NRF_PSEL(UART_TX, 0, 6)>,
                    <NRF_PSEL(UART_RX, 0, 8)>;
            low-power-enable;
        };
    };
};

&uart0 {
    pinctrl-0 = <&uart0_t470_default>;
    pinctrl-1 = <&uart0_t470_sleep>;
    pinctrl-names = "default", "sleep";
};

/* The DK's onboard QSPI flash remains physically connected to P0.17/P0.19-23. */
&qspi {
    status = "disabled";
};

/* DRV1/SENSE7 use P0.26/P0.27, normally assigned to Arduino I2C. */
&arduino_i2c {
    status = "disabled";
};

/* DRV10 uses P1.08, normally SPI1 MISO in the board defaults. */
&spi1 {
    status = "disabled";
};
