/*
 * ThinkPad T430 Revision A on the Holyiot 18010 nRF52840 module.
 *
 * SPDX-License-Identifier: MIT
 */

#define THINKPAD_T430_NO_DK_RECOVERY
#include "../thinkpad_t430/thinkpad_t430.overlay"

/ {
    chosen {
        zmk,backlight = &reva_keyboard_backlight;
    };

    reva_keyboard_backlight: reva_keyboard_backlight {
        compatible = "thinkpad,reva-pwm-backlight";
        enable-gpios = <&gpio1 12 GPIO_ACTIVE_HIGH>;
        startup-delay-ms = <35>;

        pwm_led_0 {
            pwms = <&pwm1 0 PWM_USEC(1000) PWM_POLARITY_NORMAL>;
        };
    };
};

&kscan_matrix {
    row-gpios =
        <&gpio1 3 (GPIO_ACTIVE_LOW | GPIO_OPEN_DRAIN)>,
        <&gpio0 19 (GPIO_ACTIVE_LOW | GPIO_OPEN_DRAIN)>,
        <&gpio1 9 (GPIO_ACTIVE_LOW | GPIO_OPEN_DRAIN)>,
        <&gpio0 31 (GPIO_ACTIVE_LOW | GPIO_OPEN_DRAIN)>,
        <&gpio1 10 (GPIO_ACTIVE_LOW | GPIO_OPEN_DRAIN)>,
        <&gpio1 15 (GPIO_ACTIVE_LOW | GPIO_OPEN_DRAIN)>,
        <&gpio0 29 (GPIO_ACTIVE_LOW | GPIO_OPEN_DRAIN)>,
        <&gpio0 5 (GPIO_ACTIVE_LOW | GPIO_OPEN_DRAIN)>,
        <&gpio0 2 (GPIO_ACTIVE_LOW | GPIO_OPEN_DRAIN)>,
        <&gpio1 0 (GPIO_ACTIVE_LOW | GPIO_OPEN_DRAIN)>,
        <&gpio0 23 (GPIO_ACTIVE_LOW | GPIO_OPEN_DRAIN)>,
        <&gpio1 2 (GPIO_ACTIVE_LOW | GPIO_OPEN_DRAIN)>,
        <&gpio1 7 (GPIO_ACTIVE_LOW | GPIO_OPEN_DRAIN)>,
        <&gpio0 24 (GPIO_ACTIVE_LOW | GPIO_OPEN_DRAIN)>,
        <&gpio1 6 (GPIO_ACTIVE_LOW | GPIO_OPEN_DRAIN)>,
        <&gpio1 5 (GPIO_ACTIVE_LOW | GPIO_OPEN_DRAIN)>;

    col-gpios =
        <&gpio0 3 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,
        <&gpio0 7 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,
        <&gpio0 30 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,
        <&gpio0 28 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,
        <&gpio0 4 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,
        <&gpio1 13 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,
        <&gpio0 12 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,
        <&gpio0 21 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
};

&kscan_direct {
    input-gpios =
        <&gpio1 11 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,
        <&gpio0 22 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
};

&t430_power_led { gpios = <&gpio1 1 GPIO_ACTIVE_HIGH>; };
&t430_mute_led { gpios = <&gpio0 20 GPIO_ACTIVE_HIGH>; };
&t430_micmute_led { gpios = <&gpio0 17 GPIO_ACTIVE_HIGH>; };
&t430_profile_1_led { gpios = <&gpio0 25 GPIO_ACTIVE_LOW>; };
&t430_profile_2_led { gpios = <&gpio0 11 GPIO_ACTIVE_LOW>; };
&t430_profile_3_led { gpios = <&gpio1 8 GPIO_ACTIVE_LOW>; };

&trackpoint {
    rst-gpios = <&gpio0 13 GPIO_ACTIVE_LOW>;
};

&keyboard_backlight {
    status = "disabled";
};

&pinctrl {
    pwm1_keyboard_reva_default: pwm1_keyboard_reva_default {
        group1 {
            psels = <NRF_PSEL(PWM_OUT0, 1, 4)>;
        };
    };

    pwm1_keyboard_reva_sleep: pwm1_keyboard_reva_sleep {
        group1 {
            psels = <NRF_PSEL(PWM_OUT0, 1, 4)>;
            low-power-enable;
        };
    };

    uart1_trackpoint_reva_default: uart1_trackpoint_reva_default {
        group1 {
            psels = <NRF_PSEL_DISCONNECTED(UART_TX)>,
                    <NRF_PSEL(UART_RX, 0, 15)>;
            bias-pull-up;
        };
    };

    uart1_trackpoint_reva_sleep: uart1_trackpoint_reva_sleep {
        group1 {
            psels = <NRF_PSEL_DISCONNECTED(UART_TX)>,
                    <NRF_PSEL_DISCONNECTED(UART_RX)>;
        };
    };
};

&pwm1 {
    status = "okay";
    pinctrl-0 = <&pwm1_keyboard_reva_default>;
    pinctrl-1 = <&pwm1_keyboard_reva_sleep>;
    pinctrl-names = "default", "sleep";
};

&uart0 {
    status = "disabled";
};

&uart1 {
    status = "okay";
    current-speed = <14400>;
    pinctrl-0 = <&uart1_trackpoint_reva_default>;
    pinctrl-1 = <&uart1_trackpoint_reva_sleep>;
    pinctrl-names = "default", "sleep";
};

&trackpoint_ps2 {
    scl-gpios = <&gpio0 14 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
    sda-gpios = <&gpio0 15 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
};
