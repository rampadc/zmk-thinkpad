diff --git a/src/drivers/ps2/ps2_uart.c b/src/drivers/ps2/ps2_uart.c
--- a/src/drivers/ps2/ps2_uart.c
+++ b/src/drivers/ps2/ps2_uart.c
@@ -609,10 +609,9 @@ void ps2_uart_read_process_received_byte(const struct device *dev, uint8_t byte) {
