         k_work_submit_to_queue(&ps2_uart_work_queue_cb, &data->callback_work);
     } else {
         ps2_uart_data_queue_add(dev, byte);
@@ -644,8 +643,10 @@ void ps2_uart_read_callback_work_handler(struct k_work *work) {
                                               callback_work);
     // const struct device *dev = data->dev;
 
-    data->callback_isr(data->dev, data->callback_byte);
-    data->callback_byte = 0x0;
+    struct ps2_uart_data_queue_item item;
+    while (k_msgq_get(&data->data_queue, &item, K_NO_WAIT) == 0) {
+        data->callback_isr(data->dev, item.byte);
+    }
 }
 
