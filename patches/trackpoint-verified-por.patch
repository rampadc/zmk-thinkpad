diff --git a/src/drivers/input/input_mouse_ps2.c b/src/drivers/input/input_mouse_ps2.c
--- a/src/drivers/input/input_mouse_ps2.c
+++ b/src/drivers/input/input_mouse_ps2.c
@@ -78,6 +78,12 @@ LOG_MODULE_DECLARE(zmk, CONFIG_ZMK_LOG_LEVEL);
 #define MOUSE_PS2_CMD_TP_GET_ROM_ID "\xe2\x46"
 #define MOUSE_PS2_CMD_TP_GET_ROM_ID_RESP_LEN 1
 
+#define MOUSE_PS2_CMD_TP_READ_RAM "\xe2\x80"
+#define MOUSE_PS2_CMD_TP_READ_RAM_RESP_LEN 1
+
+#define MOUSE_PS2_CMD_TP_POWER_ON_RESET "\xe2\x7f"
+#define MOUSE_PS2_CMD_TP_POWER_ON_RESET_RESP_LEN 2
+
 #define MOUSE_PS2_CMD_TP_GET_CONFIG_BYTE "\xe2\x80\x2c"
 #define MOUSE_PS2_CMD_TP_GET_CONFIG_BYTE_RESP_LEN 1
 
@@ -1756,6 +1762,38 @@ static void zmk_mouse_ps2_init_thread(int dev_ptr, int unused) {
 
     if (data->is_trackpoint == true) {
 
+        static const uint8_t diagnostic_registers[] = {0x20, 0x23, 0x26, 0x2c, 0x2d, 0x2e, 0x4b};
+        for (int i = 0; i < ARRAY_SIZE(diagnostic_registers); i++) {
+            uint8_t location = diagnostic_registers[i];
+            struct zmk_mouse_ps2_send_cmd_resp reg = zmk_mouse_ps2_send_cmd(
+                dev, MOUSE_PS2_CMD_TP_READ_RAM, sizeof(MOUSE_PS2_CMD_TP_READ_RAM), &location,
+                MOUSE_PS2_CMD_TP_READ_RAM_RESP_LEN, true);
+            if (!reg.err) {
+                LOG_INF("TrackPoint RAM before POR: %02x=%02x", location, reg.resp_buffer[0]);
+            }
+        }
+
+        LOG_INF("Executing TrackPoint-specific power-on reset (E2 7F)...");
+        struct zmk_mouse_ps2_send_cmd_resp por = zmk_mouse_ps2_send_cmd(
+            dev, MOUSE_PS2_CMD_TP_POWER_ON_RESET, sizeof(MOUSE_PS2_CMD_TP_POWER_ON_RESET), NULL,
+            MOUSE_PS2_CMD_TP_POWER_ON_RESET_RESP_LEN, true);
+        if (por.err || por.resp_buffer[0] != 0xaa || por.resp_buffer[1] != 0x00) {
+            LOG_ERR("TrackPoint POR failed: err=%d response=%02x %02x", por.err,
+                    por.resp_buffer[0], por.resp_buffer[1]);
+            return;
+        }
+        LOG_INF("TrackPoint POR succeeded: aa 00");
+
+        for (int i = 0; i < ARRAY_SIZE(diagnostic_registers); i++) {
+            uint8_t location = diagnostic_registers[i];
+            struct zmk_mouse_ps2_send_cmd_resp reg = zmk_mouse_ps2_send_cmd(
+                dev, MOUSE_PS2_CMD_TP_READ_RAM, sizeof(MOUSE_PS2_CMD_TP_READ_RAM), &location,
+                MOUSE_PS2_CMD_TP_READ_RAM_RESP_LEN, true);
+            if (!reg.err) {
+                LOG_INF("TrackPoint RAM after POR: %02x=%02x", location, reg.resp_buffer[0]);
+            }
+        }
+
         if (config->tp_press_to_select) {
             LOG_INF("Enabling TP press to select...");
             zmk_mouse_ps2_tp_press_to_select_set(dev, true);
